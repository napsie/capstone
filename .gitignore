# Python virtual environment
python_api/venv/

# Python cache
**/__pycache__/
*.pyc

# OS-specific files
.DS_Store
Thumbs.db

# Local database backups contain private application data
database_backups/*.sql
database_backups/*.zip

# Runtime applicant records and PHP sessions must never enter source control.
uploads/*
!uploads/.gitkeep
!uploads/.htaccess
tmp/sessions/*
!tmp/sessions/.gitkeep
!tmp/sessions/.htaccess
